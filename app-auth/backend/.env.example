# ============================================================
# Fichier d'exemple : copiez-le en ".env" puis remplissez-le.
#   cp .env.example .env
# Le fichier .env n'est JAMAIS envoyé sur Git (voir .gitignore).
# ============================================================

# URL complète de la base PostgreSQL (Internal URL sur Render)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_auth

# "true" si la base exige le SSL (URL externe Render), "false" sinon
DB_SSL=false

# Phrase secrète utilisée pour signer les tokens JWT
# (à changer ! longue et aléatoire en production)
JWT_SECRET=changez_cette_phrase_en_local

# Port d'écoute du serveur
PORT=4000

# URL du frontend autorisée à appeler l'API (CORS)
CORS_ORIGIN=http://localhost:5173
